# Dashboard template only. No cloud resources or domains have been created.
# Replace placeholders before starting the API. Never put these in Expo's env.
AGRISENSE_ENV=production
AGRISENSE_ALLOWED_HOSTS=REPLACE_RAILWAY_HOST,healthcheck.railway.app,127.0.0.1
# Preferred hostname, not yet reserved; update if the owner selects an alternative.
AGRISENSE_CORS_ORIGINS=https://agrisense.pages.dev
AGRISENSE_ACCESS_ISSUER=https://REPLACE_TEAM.cloudflareaccess.com
AGRISENSE_ACCESS_AUD=REPLACE_PRODUCTION_ACCESS_APPLICATION_AUD
AGRISENSE_DEMO_EMAILS=REPLACE_WITH_EXPLICIT_INVITED_EMAILS
AGRISENSE_DB_PATH=/data/journal/agrisense.db
AGRISENSE_UPLOAD_DIR=/data/uploads
AGRISENSE_CHECKPOINT_PATH=/data/models/tomato-best.pt
AGRISENSE_CHECKPOINT_SHA256=18372991aaf467e5aea4c5d1f3c9b4c6e8a17ef3a6586758c4644572c4f43b9c
AGRISENSE_PLANT_VERIFIER_WEIGHTS=/data/models/open_clip_model.safetensors
AGRISENSE_PLANT_VERIFIER_SHA256=e6d1bd7789aa45192b3bf90570a789b478bae1b74ebcce7eddd908e83a2b7c31
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/data/cache/huggingface
TORCH_HOME=/data/cache/torch
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
# Railway volumes initially belong to root. backend.serve prepares only the app
# directories and drops to UID/GID 10001 before loading models or serving HTTP.
RAILWAY_RUN_UID=0
# PORT is injected by Railway. Do not hard-code 8000 in a start override.
