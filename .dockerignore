# Explicit build-context allowlist: private datasets, weights, photos, SQLite,
# credentials, untracked research and local caches never reach the builder.
**
!Dockerfile
!.dockerignore
!backend/
backend/**
!backend/requirements-production.txt
!backend/serve.py
!backend/backup.py
!backend/restore_demo.py
!backend/app/
backend/app/**
!backend/app/*.py
!model/
model/**
!model/agrisense_model/
model/agrisense_model/**
!model/agrisense_model/*.py
!model/configs/
model/configs/**
!model/configs/tomato.json
**/__pycache__
**/*.pyc
